{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/provider/v1/activate",
    "bodyPatterns": [
      { "matchesJsonPath": { "expression": "$.productCode", "equalTo": "SIMULATE-TIMEOUT" } }
    ]
  },
  "response": {
    "status": 200,
    "fixedDelayMilliseconds": 5000,
    "jsonBody": { "result": "activated" }
  }
}
